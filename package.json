{
  "name": "ipynb-pdf-converter",
  "displayName": "NotePDF",
  "description": "%description%",
  "version": "0.15.1",
  "publisher": "leekh",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekh4232/notepdf"
  },
  "homepage": "https://notepdf.hossam.kr/",
  "author": {
    "name": "이광호",
    "email": "leekh4232@gmail.com"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ipynb",
    "jupyter",
    "notebook",
    "markdown",
    "pdf",
    "note",
    "handout",
    "password"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "commands": [
      {
        "command": "ipynb-pdf-converter.convertToPdf",
        "title": "%cmd.convertToPdf.title%",
        "category": "Jupyter"
      },
      {
        "command": "ipynb-pdf-converter.convertToPdfWithPassword",
        "title": "%cmd.convertToPdfWithPassword.title%",
        "category": "Jupyter"
      },
      {
        "command": "ipynb-pdf-converter.convertToPdfTeacher",
        "title": "%cmd.convertToPdfTeacher.title%",
        "category": "Jupyter"
      },
      {
        "command": "ipynb-pdf-converter.convertToPdfTeacherWithPassword",
        "title": "%cmd.convertToPdfTeacherWithPassword.title%",
        "category": "Jupyter"
      },
      {
        "command": "ipynb-pdf-converter.addNotes",
        "title": "%note.cmd.addNotes.title%",
        "category": "Note"
      },
      {
        "command": "ipynb-pdf-converter.addNotesWithPassword",
        "title": "%note.cmd.addNotesWithPassword.title%",
        "category": "Note"
      },
      {
        "command": "ipynb-pdf-converter.addNotesTeacher",
        "title": "%note.cmd.addNotesTeacher.title%",
        "category": "Note"
      },
      {
        "command": "ipynb-pdf-converter.addNotesTeacherWithPassword",
        "title": "%note.cmd.addNotesTeacherWithPassword.title%",
        "category": "Note"
      }
    ],
    "submenus": [
      {
        "id": "ipynb-pdf-converter.submenu",
        "label": "%submenu.label%"
      },
      {
        "id": "ipynb-pdf-converter.noteSubmenu",
        "label": "%note.submenu.label%"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "submenu": "ipynb-pdf-converter.submenu",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@98"
        },
        {
          "submenu": "ipynb-pdf-converter.noteSubmenu",
          "when": "resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@90"
        }
      ],
      "editor/title/context": [
        {
          "submenu": "ipynb-pdf-converter.submenu",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@98"
        },
        {
          "submenu": "ipynb-pdf-converter.noteSubmenu",
          "when": "resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@90"
        }
      ],
      "editor/context": [
        {
          "submenu": "ipynb-pdf-converter.submenu",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@98"
        },
        {
          "submenu": "ipynb-pdf-converter.noteSubmenu",
          "when": "resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md",
          "group": "navigation@90"
        }
      ],
      "notebook/cell/title": [
        {
          "submenu": "ipynb-pdf-converter.submenu",
          "when": "notebookType == jupyter-notebook",
          "group": "z_convert@98"
        },
        {
          "submenu": "ipynb-pdf-converter.noteSubmenu",
          "when": "notebookType == jupyter-notebook",
          "group": "z_note@90"
        }
      ],
      "commandPalette": [
        {
          "command": "ipynb-pdf-converter.convertToPdf",
          "when": "resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook'"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfWithPassword",
          "when": "resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook'"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfTeacher",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook') && config.notepdf.teacherMode"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfTeacherWithPassword",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md || activeEditor == 'workbench.editor.notebook') && config.notepdf.teacherMode"
        },
        {
          "command": "ipynb-pdf-converter.addNotes",
          "when": "resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md"
        },
        {
          "command": "ipynb-pdf-converter.addNotesWithPassword",
          "when": "resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md"
        },
        {
          "command": "ipynb-pdf-converter.addNotesTeacher",
          "when": "(resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md) && config.notepdf.teacherMode"
        },
        {
          "command": "ipynb-pdf-converter.addNotesTeacherWithPassword",
          "when": "(resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md) && config.notepdf.teacherMode"
        }
      ],
      "ipynb-pdf-converter.submenu": [
        {
          "command": "ipynb-pdf-converter.convertToPdf",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "1_default@0"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfWithPassword",
          "when": "resourceExtname == .ipynb || resourceExtname == .md",
          "group": "1_default@1"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfTeacher",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.notepdf.teacherMode",
          "group": "2_teacher@2"
        },
        {
          "command": "ipynb-pdf-converter.convertToPdfTeacherWithPassword",
          "when": "(resourceExtname == .ipynb || resourceExtname == .md) && config.notepdf.teacherMode",
          "group": "2_teacher@3"
        }
      ],
      "ipynb-pdf-converter.noteSubmenu": [
        {
          "command": "ipynb-pdf-converter.addNotes",
          "when": "resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md",
          "group": "1_default@0"
        },
        {
          "command": "ipynb-pdf-converter.addNotesWithPassword",
          "when": "resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md",
          "group": "1_default@1"
        },
        {
          "command": "ipynb-pdf-converter.addNotesTeacher",
          "when": "(resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md) && config.notepdf.teacherMode",
          "group": "2_teacher@2"
        },
        {
          "command": "ipynb-pdf-converter.addNotesTeacherWithPassword",
          "when": "(resourceExtname == .pdf || resourceExtname == .ipynb || resourceExtname == .md) && config.notepdf.teacherMode",
          "group": "2_teacher@3"
        }
      ]
    },
    "configuration": [
      {
        "title": "%config.title%",
        "properties": {
          "notepdf.pdfTheme": {
            "type": "string",
            "default": "light",
            "enum": [
              "default",
              "light",
              "dark"
            ],
            "enumDescriptions": [
              "%config.pdfTheme.enum.0%",
              "%config.pdfTheme.enum.1%",
              "%config.pdfTheme.enum.2%"
            ],
            "description": "%config.pdfTheme.description%"
          },
          "notepdf.codeTheme": {
            "type": "string",
            "default": "mdr-dark",
            "enum": [
              "mdr-dark",
              "mdr-light",
              "dracula",
              "github",
              "github-dark",
              "atom-one-light",
              "atom-one-dark",
              "monokai",
              "nord",
              "vs2015",
              "leekh"
            ],
            "enumDescriptions": [
              "%config.codeTheme.enum.0%",
              "%config.codeTheme.enum.1%",
              "%config.codeTheme.enum.2%",
              "%config.codeTheme.enum.3%",
              "%config.codeTheme.enum.4%",
              "%config.codeTheme.enum.5%",
              "%config.codeTheme.enum.6%",
              "%config.codeTheme.enum.7%",
              "%config.codeTheme.enum.8%",
              "%config.codeTheme.enum.9%",
              "%config.codeTheme.enum.10%"
            ],
            "description": "%config.codeTheme.description%"
          },
          "notepdf.pdfPageSize": {
            "type": "string",
            "default": "A4",
            "enum": [
              "A3",
              "A4",
              "A5",
              "B4",
              "B5",
              "Letter",
              "Legal",
              "Widescreen",
              "iPadPro13",
              "iPadPro11",
              "iPadAir13",
              "iPad11",
              "iPadMini",
              "GalaxyTabS11",
              "GalaxyTabS11Ultra"
            ],
            "enumDescriptions": [
              "%config.pdfPageSize.enum.0%",
              "%config.pdfPageSize.enum.1%",
              "%config.pdfPageSize.enum.2%",
              "%config.pdfPageSize.enum.3%",
              "%config.pdfPageSize.enum.4%",
              "%config.pdfPageSize.enum.5%",
              "%config.pdfPageSize.enum.6%",
              "%config.pdfPageSize.enum.7%",
              "%config.pdfPageSize.enum.8%",
              "%config.pdfPageSize.enum.9%",
              "%config.pdfPageSize.enum.10%",
              "%config.pdfPageSize.enum.11%",
              "%config.pdfPageSize.enum.12%",
              "%config.pdfPageSize.enum.13%",
              "%config.pdfPageSize.enum.14%"
            ],
            "description": "%config.pdfPageSize.description%"
          },
          "notepdf.pdfPageOrientation": {
            "type": "string",
            "default": "portrait",
            "enum": [
              "portrait",
              "landscape"
            ],
            "description": "%config.pdfPageOrientation.description%"
          },
          "notepdf.pdfPageMargin": {
            "type": "number",
            "default": 48,
            "minimum": 0,
            "maximum": 200,
            "description": "%config.pdfPageMargin.description%"
          },
          "notepdf.outputDirectory": {
            "type": "string",
            "default": "",
            "description": "%config.outputDirectory.description%"
          },
          "notepdf.outputFileName": {
            "type": "string",
            "default": "{name}",
            "description": "%config.outputFileName.description%"
          },
          "notepdf.openAfterConvert": {
            "type": "boolean",
            "default": false,
            "description": "%config.openAfterConvert.description%"
          },
          "notepdf.headerText": {
            "type": "string",
            "default": "{file}",
            "description": "%config.headerText.description%"
          },
          "notepdf.footerText": {
            "type": "string",
            "default": "{page} / {total}",
            "description": "%config.footerText.description%"
          },
          "notepdf.headerAlign": {
            "type": "string",
            "default": "right",
            "enum": [
              "left",
              "center",
              "right"
            ],
            "description": "%config.headerAlign.description%"
          },
          "notepdf.footerAlign": {
            "type": "string",
            "default": "right",
            "enum": [
              "left",
              "center",
              "right"
            ],
            "description": "%config.footerAlign.description%"
          },
          "notepdf.headerFooterFontSize": {
            "type": "number",
            "default": 10,
            "minimum": 6,
            "maximum": 24,
            "description": "%config.headerFooterFontSize.description%"
          },
          "notepdf.pageBreakBefore": {
            "type": "string",
            "default": "none",
            "enum": [
              "h1",
              "h1-h2",
              "none"
            ],
            "enumDescriptions": [
              "%config.pageBreakBefore.enum.0%",
              "%config.pageBreakBefore.enum.1%",
              "%config.pageBreakBefore.enum.2%"
            ],
            "description": "%config.pageBreakBefore.description%"
          },
          "notepdf.breakBeforeTags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.breakBeforeTags.description%"
          },
          "notepdf.hideCodeCells": {
            "type": "boolean",
            "default": false,
            "description": "%config.hideCodeCells.description%"
          },
          "notepdf.hideOutputs": {
            "type": "boolean",
            "default": false,
            "description": "%config.hideOutputs.description%"
          },
          "notepdf.excludeCellTags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "%config.excludeCellTags.description%"
          },
          "notepdf.tableNowrap": {
            "type": "string",
            "default": "first",
            "enum": [
              "first",
              "all",
              "none"
            ],
            "enumDescriptions": [
              "%config.tableNowrap.enum.0%",
              "%config.tableNowrap.enum.1%",
              "%config.tableNowrap.enum.2%"
            ],
            "description": "%config.tableNowrap.description%"
          },
          "notepdf.showLineNumbers": {
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "on",
              "off"
            ],
            "enumDescriptions": [
              "%config.showLineNumbers.enum.0%",
              "%config.showLineNumbers.enum.1%",
              "%config.showLineNumbers.enum.2%"
            ],
            "description": "%config.showLineNumbers.description%"
          },
          "notepdf.baseFontSize": {
            "type": "number",
            "default": 16,
            "minimum": 8,
            "maximum": 32,
            "description": "%config.baseFontSize.description%"
          },
          "notepdf.bodyFontFamily": {
            "type": "string",
            "default": "",
            "description": "%config.bodyFontFamily.description%"
          },
          "notepdf.codeFontFamily": {
            "type": "string",
            "default": "",
            "description": "%config.codeFontFamily.description%"
          },
          "notepdf.imageFormat": {
            "type": "string",
            "default": "png",
            "enum": [
              "png",
              "jpeg"
            ],
            "enumDescriptions": [
              "%config.imageFormat.enum.0%",
              "%config.imageFormat.enum.1%"
            ],
            "description": "%config.imageFormat.description%"
          },
          "notepdf.jpegQuality": {
            "type": "number",
            "default": 85,
            "minimum": 10,
            "maximum": 100,
            "description": "%config.jpegQuality.description%"
          },
          "notepdf.deviceScaleFactor": {
            "type": "number",
            "default": 3,
            "minimum": 1,
            "maximum": 5,
            "description": "%config.deviceScaleFactor.description%"
          },
          "notepdf.pdfPassword": {
            "type": "string",
            "default": "",
            "description": "%config.pdfPassword.description%"
          },
          "notepdf.pdfPermissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "print",
                "copy",
                "modify",
                "annot-forms"
              ]
            },
            "uniqueItems": true,
            "default": [
              "annot-forms"
            ],
            "description": "%config.pdfPermissions.description%"
          },
          "notepdf.ownerPassword": {
            "type": "string",
            "default": "",
            "description": "%config.ownerPassword.description%"
          },
          "notepdf.coverPage": {
            "type": "boolean",
            "default": false,
            "description": "%config.coverPage.description%"
          },
          "notepdf.coverTitle": {
            "type": "string",
            "default": "{file}",
            "description": "%config.coverTitle.description%"
          },
          "notepdf.coverSubtitle": {
            "type": "string",
            "default": "",
            "description": "%config.coverSubtitle.description%"
          },
          "notepdf.coverAuthor": {
            "type": "string",
            "default": "",
            "description": "%config.coverAuthor.description%"
          },
          "notepdf.watermarkImage": {
            "type": "string",
            "default": "",
            "description": "%config.watermarkImage.description%"
          },
          "notepdf.watermarkWidth": {
            "type": "number",
            "default": 100,
            "minimum": 10,
            "maximum": 2000,
            "description": "%config.watermarkWidth.description%"
          },
          "notepdf.allowRemoteImages": {
            "type": "boolean",
            "default": true,
            "description": "%config.allowRemoteImages.description%"
          },
          "notepdf.renderTimeoutSeconds": {
            "type": "number",
            "default": 60,
            "minimum": 10,
            "maximum": 600,
            "description": "%config.renderTimeoutSeconds.description%"
          },
          "notepdf.teacherMode": {
            "type": "boolean",
            "default": false,
            "description": "%config.teacherMode.description%"
          }
        }
      },
      {
        "title": "%note.config.title%",
        "properties": {
          "notepdf.note.paperSize": {
            "type": "string",
            "default": "original",
            "enum": [
              "original",
              "A0",
              "A1",
              "A2",
              "A3",
              "A4",
              "A5",
              "A6",
              "B0",
              "B1",
              "B2",
              "B3",
              "B4",
              "B5",
              "B6",
              "LETTER",
              "LEGAL",
              "TABLOID",
              "LEDGER",
              "iPadPro13",
              "iPadPro11",
              "iPadAir13",
              "iPad11",
              "iPadMini",
              "GalaxyTabS11",
              "GalaxyTabS11Ultra"
            ],
            "description": "%note.config.paperSize.description%",
            "enumDescriptions": [
              "%note.config.paperSize.enum.0%",
              "%note.config.paperSize.enum.1%",
              "%note.config.paperSize.enum.2%",
              "%note.config.paperSize.enum.3%",
              "%note.config.paperSize.enum.4%",
              "%note.config.paperSize.enum.5%",
              "%note.config.paperSize.enum.6%",
              "%note.config.paperSize.enum.7%",
              "%note.config.paperSize.enum.8%",
              "%note.config.paperSize.enum.9%",
              "%note.config.paperSize.enum.10%",
              "%note.config.paperSize.enum.11%",
              "%note.config.paperSize.enum.12%",
              "%note.config.paperSize.enum.13%",
              "%note.config.paperSize.enum.14%",
              "%note.config.paperSize.enum.15%",
              "%note.config.paperSize.enum.16%",
              "%note.config.paperSize.enum.17%",
              "%note.config.paperSize.enum.18%",
              "%note.config.paperSize.enum.19%",
              "%note.config.paperSize.enum.20%",
              "%note.config.paperSize.enum.21%",
              "%note.config.paperSize.enum.22%",
              "%note.config.paperSize.enum.23%",
              "%note.config.paperSize.enum.24%",
              "%note.config.paperSize.enum.25%"
            ]
          },
          "notepdf.note.layoutMode": {
            "type": "string",
            "default": "note",
            "enum": [
              "note",
              "feedback"
            ],
            "enumDescriptions": [
              "%note.config.layoutMode.enum.0%",
              "%note.config.layoutMode.enum.1%"
            ],
            "description": "%note.config.layoutMode.description%"
          },
          "notepdf.note.feedbackBannerImage": {
            "type": "string",
            "default": "",
            "description": "%note.config.feedbackBannerImage.description%"
          },
          "notepdf.note.lineGap": {
            "type": "number",
            "default": 18,
            "minimum": 6,
            "maximum": 60,
            "description": "%note.config.lineGap.description%"
          },
          "notepdf.note.headerText": {
            "type": "string",
            "default": "{file}",
            "description": "%note.config.headerText.description%"
          },
          "notepdf.note.footerText": {
            "type": "string",
            "default": "{page} / {total}",
            "description": "%note.config.footerText.description%"
          },
          "notepdf.note.headerAlign": {
            "type": "string",
            "default": "left",
            "enum": [
              "left",
              "center",
              "right"
            ],
            "description": "%note.config.headerAlign.description%"
          },
          "notepdf.note.footerAlign": {
            "type": "string",
            "default": "right",
            "enum": [
              "left",
              "center",
              "right"
            ],
            "description": "%note.config.footerAlign.description%"
          },
          "notepdf.note.headerFooterFontSize": {
            "type": "number",
            "default": 10,
            "minimum": 6,
            "maximum": 24,
            "description": "%note.config.headerFooterFontSize.description%"
          },
          "notepdf.note.outputFileName": {
            "type": "string",
            "default": "{name}_note",
            "description": "%note.config.outputFileName.description%"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run vendor && npm run typecheck && npm run build",
    "vendor": "node scripts/vendor.mjs",
    "build": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --target=node18 --external:vscode --format=cjs --minify",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --platform=node --target=node18 --external:vscode --format=cjs --sourcemap --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "pretest": "npm run typecheck && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.4.2",
    "@types/vscode": "^1.84.0",
    "@typescript-eslint/eslint-plugin": "^6.2.1",
    "@typescript-eslint/parser": "^6.2.1",
    "@vscode/test-electron": "^2.3.3",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.20.0",
    "eslint": "^8.45.0",
    "github-markdown-css": "^5.9.0",
    "glob": "^10.3.3",
    "html2canvas": "^1.4.1",
    "mocha": "^10.2.0",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "@cantoo/fontkit": "^2.0.12",
    "@cantoo/pdf-lib": "^2.11.1",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.0"
  }
}
